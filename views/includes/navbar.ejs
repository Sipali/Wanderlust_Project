<nav class="bg-white/95 backdrop-blur-md border-b border-gray-200 sticky top-0 z-40 transition-all duration-300 shadow-sm py-3">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    <a class="flex items-center gap-2 text-brand font-bold text-xl tracking-tight transition-transform hover:scale-105 decoration-none shrink-0" href="/listings">
      <div class="w-9 h-9 bg-red-50 text-[#fe424d] rounded-xl flex items-center justify-center shadow-xs">
        <i data-lucide="compass" class="w-5 h-5 stroke-[2.5]"></i>
      </div>
      <span class="font-extrabold text-[#fe424d] tracking-tight text-xl hidden sm:inline">wanderlust</span>
    </a>

    <!-- Destination Search Bar -->
    <form action="/listings" method="GET" class="flex-1 max-w-sm sm:max-w-md mx-2">
      <div class="flex items-center bg-gray-100/80 rounded-full px-3 py-1.5 border border-gray-200 focus-within:bg-white focus-within:border-[#fe424d] focus-within:ring-2 focus-within:ring-red-100 transition-all shadow-xs">
        <i data-lucide="search" class="w-4 h-4 text-gray-400 shrink-0 ml-1"></i>
        <input
          type="text"
          name="search"
          placeholder="Search destination, city, or country..."
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          class="bg-transparent text-xs sm:text-sm font-medium text-gray-700 outline-none w-full px-2.5 border-0 focus:ring-0"
        />
        <% if(typeof searchQuery !== 'undefined' && searchQuery) { %>
          <a href="/listings" class="text-gray-400 hover:text-gray-600 p-1 text-xs mr-1 decoration-none">
            <i data-lucide="x" class="w-3.5 h-3.5"></i>
          </a>
        <% } %>
        <button type="submit" class="px-3 py-1.5 bg-[#fe424d] hover:bg-[#e0323d] text-white font-semibold rounded-full flex items-center justify-center transition-all cursor-pointer border-0 text-xs shrink-0 shadow-xs">
          Search
        </button>
      </div>
    </form>

    <!-- Right Actions -->
    <div class="flex items-center gap-2.5 shrink-0">
      <div class="hidden lg:flex items-center gap-2">
        <a class="px-3.5 py-2 rounded-full font-semibold text-gray-700 hover:text-[#fe424d] hover:bg-red-50/80 transition-all flex items-center gap-1.5 decoration-none text-xs" href="/listings/new">
          <i data-lucide="plus-circle" class="w-4 h-4 text-[#fe424d]"></i>
          <span>Add your home</span>
        </a>
      </div>

      <div class="hidden md:flex items-center gap-2.5">
        <% if(!currUser) { %>
          <a href="/login" class="px-4 py-2 bg-[#fe424d] text-white font-bold rounded-full hover:bg-[#e0323d] shadow-sm hover:shadow transition-all text-xs flex items-center gap-1.5 !text-white decoration-none cursor-pointer">
            <i data-lucide="log-in" class="w-3.5 h-3.5"></i>
            <span>Log in</span>
          </a>
          <a href="/signup" class="px-4 py-2 border border-gray-300 text-gray-700 font-semibold rounded-full hover:bg-gray-100 hover:text-[#fe424d] transition-all text-xs flex items-center gap-1.5 decoration-none cursor-pointer">
            <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
            <span>Sign up</span>
          </a>
        <% } %>
        <% if(currUser){ %>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-gray-700 bg-gray-100 px-3 py-1.5 rounded-full flex items-center gap-1.5 border border-gray-200">
              <i data-lucide="user" class="w-3.5 h-3.5 text-[#fe424d]"></i>
              <span><%= currUser.username %></span>
            </span>
            <button onclick="openLogoutModal()" type="button" class="px-3 py-1.5 rounded-full text-xs font-semibold text-gray-600 border border-gray-200 hover:bg-red-50 hover:text-red-600 transition-all flex items-center gap-1 decoration-none cursor-pointer bg-transparent">
              <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
              <span>Log out</span>
            </button>
          </div>
        <% } %>
      </div>

      <button onclick="toggleMobileNav()" type="button" aria-label="Toggle navigation menu" class="md:hidden p-2 rounded-xl border border-gray-200 text-gray-700 hover:bg-gray-100 transition-all bg-transparent border-0 cursor-pointer">
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>
    </div>
  </div>
</nav>

<div id="mobileNavDrawer" class="fixed inset-0 z-50 flex justify-end opacity-0 pointer-events-none transition-opacity duration-300">
  <div onclick="toggleMobileNav()" class="absolute inset-0 bg-black/50 backdrop-blur-xs"></div>

  <div id="mobileNavPanel" class="relative w-4/5 max-w-xs bg-white h-full shadow-2xl p-6 flex flex-col justify-between transform translate-x-full transition-transform duration-300 border-l border-gray-100">
    <div>
      <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-red-50 text-[#fe424d] rounded-lg flex items-center justify-center">
            <i data-lucide="compass" class="w-4 h-4 stroke-[2.5]"></i>
          </div>
          <span class="font-extrabold text-[#fe424d] text-lg">wanderlust</span>
        </div>
        <button onclick="toggleMobileNav()" type="button" class="p-2 rounded-full text-gray-400 hover:text-gray-800 hover:bg-gray-100 transition-all border-0 bg-transparent cursor-pointer">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <nav class="space-y-2">
        <a href="/listings" class="flex items-center gap-3 px-4 py-3 rounded-2xl font-semibold text-gray-700 hover:bg-red-50 hover:text-[#fe424d] transition-all decoration-none text-sm">
          <i data-lucide="home" class="w-4 h-4"></i>
          <span>Home</span>
        </a>
        <a href="/listings" class="flex items-center gap-3 px-4 py-3 rounded-2xl font-semibold text-gray-700 hover:bg-red-50 hover:text-[#fe424d] transition-all decoration-none text-sm">
          <i data-lucide="grid" class="w-4 h-4"></i>
          <span>Explore Listings</span>
        </a>
        <a href="/listings/new" class="flex items-center gap-3 px-4 py-3 rounded-2xl font-semibold text-gray-700 hover:bg-red-50 hover:text-[#fe424d] transition-all decoration-none text-sm">
          <i data-lucide="plus-circle" class="w-4 h-4 text-[#fe424d]"></i>
          <span>Add your home</span>
        </a>
      </nav>
    </div>

    <div class="border-t border-gray-100 pt-6 space-y-3">
      <% if(!currUser) { %>
        <a href="/login" class="w-full py-3 bg-[#fe424d] text-white font-bold rounded-2xl flex items-center justify-center gap-2 decoration-none text-sm shadow-sm">
          <i data-lucide="log-in" class="w-4 h-4"></i>
          <span>Log in</span>
        </a>
        <a href="/signup" class="w-full py-3 border border-gray-300 text-gray-700 font-semibold rounded-2xl flex items-center justify-center gap-2 decoration-none text-sm hover:bg-gray-50">
          <i data-lucide="user-plus" class="w-4 h-4"></i>
          <span>Sign up</span>
        </a>
      <% } else { %>
        <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 mb-3 flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-red-100 text-[#fe424d] font-bold flex items-center justify-center text-sm">
            <%= currUser.username.charAt(0).toUpperCase() %>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm"><%= currUser.username %></p>
            <p class="text-xs text-gray-500">Logged in</p>
          </div>
        </div>
        <button onclick="toggleMobileNav(); openLogoutModal();" type="button" class="w-full py-3 border border-rose-200 text-rose-600 bg-rose-50 font-semibold rounded-2xl flex items-center justify-center gap-2 cursor-pointer text-sm">
          <i data-lucide="log-out" class="w-4 h-4"></i>
          <span>Log out</span>
        </button>
      <% } %>
    </div>
  </div>
</div>

<script>
  function toggleMobileNav() {
    const drawer = document.getElementById('mobileNavDrawer');
    const panel = document.getElementById('mobileNavPanel');
    if (drawer && panel) {
      const isHidden = drawer.classList.contains('opacity-0');
      if (isHidden) {
        drawer.classList.remove('opacity-0', 'pointer-events-none');
        drawer.classList.add('opacity-100');
        panel.classList.remove('translate-x-full');
        panel.classList.add('translate-x-0');
      } else {
        drawer.classList.remove('opacity-100');
        drawer.classList.add('opacity-0', 'pointer-events-none');
        panel.classList.remove('translate-x-0');
        panel.classList.add('translate-x-full');
      }
      if (window.lucide) window.lucide.createIcons();
    }
  }
</script>