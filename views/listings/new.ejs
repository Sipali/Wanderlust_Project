<% layout("/layouts/boilerplate") %>

<div class="max-w-3xl mx-auto py-6">
  <div class="mb-4">
    <button onclick="history.back()" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-gray-200 text-gray-700 hover:text-black hover:bg-gray-100 text-xs font-semibold shadow-xs transition-all cursor-pointer">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span>Back</span>
    </button>
  </div>

  <div class="bg-white rounded-3xl p-6 sm:p-10 border border-gray-200 shadow-md">
    <div class="mb-8 border-b border-gray-100 pb-4">
      <h2 class="text-2xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2">
        <i class="fa-solid fa-house-medical text-[#fe424d]"></i>
        Create a New Listing
      </h2>
      <p class="text-gray-500 text-sm mt-1">Host your home and welcome guests from around the world.</p>
    </div>

    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation space-y-6"
      enctype="multipart/form-data"
    >
      <div>
        <label for="title" class="block text-sm font-semibold text-gray-700 mb-1.5">Property Title</label>
        <input
          name="listing[title]"
          placeholder="Add a catchy title e.g. Cozy Beachside Villa"
          type="text"
          class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
          required
        />
        <div class="valid-feedback text-xs text-emerald-600 mt-1">Title looks good!</div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="description" class="block text-sm font-semibold text-gray-700">Description</label>
          <span id="descCount" class="text-xs text-gray-400 font-medium">0 / 500</span>
        </div>
        <textarea
          name="listing[description]"
          placeholder="Describe your property, amenities, nearby attractions..."
          rows="4"
          maxlength="500"
          oninput="document.getElementById('descCount').textContent = `${this.value.length} / 500`"
          class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
          required
        ></textarea>
        <div class="invalid-feedback text-xs text-rose-500 mt-1">Please enter short description</div>
      </div>

      <div>
        <label for="image" class="block text-sm font-semibold text-gray-700 mb-1.5">Upload Listing Image</label>
        <div class="relative border-2 border-dashed border-gray-300 hover:border-[#fe424d] bg-gray-50/50 rounded-2xl p-6 text-center transition-all">
          <input
            name="listing[image]"
            type="file"
            accept="image/*"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
            required
            onchange="if(this.files[0]) document.getElementById('fileName').textContent = this.files[0].name;"
          />
          <div class="space-y-2">
            <div class="w-10 h-10 rounded-full bg-red-50 text-[#fe424d] flex items-center justify-center mx-auto">
              <i data-lucide="upload-cloud" class="w-5 h-5"></i>
            </div>
            <p class="text-xs font-semibold text-gray-700">Click to upload or drag & drop</p>
            <p id="fileName" class="text-[11px] text-gray-400 truncate max-w-xs mx-auto">PNG, JPG, WEBP up to 10MB</p>
          </div>
        </div>
      </div>

      <div>
        <label for="category" class="block text-sm font-semibold text-gray-700 mb-1.5">Category</label>
        <select
          name="listing[category]"
          class="form-select w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
          required
        >
          <option value="Trending">Trending</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic Cities">Iconic Cities</option>
          <option value="Castles">Castles</option>
          <option value="Mountains">Mountains</option>
          <option value="Amazing Views">Amazing Views</option>
          <option value="Farms">Farms</option>
          <option value="Beach">Beach</option>
          <option value="Camping">Camping</option>
          <option value="Arctic">Arctic</option>
          <option value="Domes">Domes</option>
          <option value="Boats">Boats</option>
        </select>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="price" class="block text-sm font-semibold text-gray-700 mb-1.5">Price (₹ / night)</label>
          <input
            name="listing[price]"
            placeholder="1200"
            type="number"
            class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
            required
          />
          <div class="invalid-feedback text-xs text-rose-500 mt-1">Price should be valid</div>
        </div>

        <div>
          <label for="country" class="block text-sm font-semibold text-gray-700 mb-1.5">Country</label>
          <input
            name="listing[country]"
            placeholder="India"
            type="text"
            class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
            required
          />
          <div class="invalid-feedback text-xs text-rose-500 mt-1">Country should be valid</div>
        </div>
      </div>

      <div>
        <label for="location" class="block text-sm font-semibold text-gray-700 mb-1.5">Location / City</label>
        <input
          name="listing[location]"
          placeholder="Jaipur, Rajasthan"
          type="text"
          class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
          required
        />
        <div class="invalid-feedback text-xs text-rose-500 mt-1">Location should be valid</div>
      </div>

      <div class="pt-4">
        <button class="w-full sm:w-auto px-8 py-3 bg-[#fe424d] text-white font-bold rounded-xl hover:bg-[#e0323d] transition-all shadow-md hover:shadow-lg border-0 cursor-pointer text-base">
          Publish Listing
        </button>
      </div>
    </form>
  </div>
</div>
