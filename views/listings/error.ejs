<% layout("/layouts/boilerplate") %>

<div class="max-w-md mx-auto py-12 text-center">
  <div class="bg-white rounded-3xl p-8 sm:p-10 border border-rose-200 shadow-xl space-y-6">
    
    <div class="w-20 h-20 bg-rose-50 text-rose-500 rounded-3xl flex items-center justify-center mx-auto shadow-inner">
      <i data-lucide="alert-triangle" class="w-10 h-10 stroke-[2]"></i>
    </div>

    <div>
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Oops! Something went wrong</h1>
      <p class="text-sm text-rose-600 bg-rose-50 border border-rose-200 p-3 rounded-xl max-w-sm mx-auto leading-relaxed">
        <%= message %>
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <button onclick="history.back()" type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-xl border border-gray-300 text-gray-700 font-semibold text-xs sm:text-sm hover:bg-gray-100 transition-all border-0 cursor-pointer flex items-center justify-center gap-1.5">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Go Back</span>
      </button>
      <a href="/listings" class="w-full sm:w-auto px-5 py-2.5 bg-[#fe424d] text-white font-bold rounded-xl hover:bg-[#e0323d] transition-all shadow-sm text-xs sm:text-sm flex items-center justify-center gap-1.5 decoration-none !text-white">
        <i data-lucide="home" class="w-4 h-4"></i>
        <span>Explore Listings</span>
      </a>
    </div>

  </div>
</div>
