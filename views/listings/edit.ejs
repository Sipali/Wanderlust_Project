<% layout("/layouts/boilerplate") %>

<div class="max-w-3xl mx-auto py-6">
  <div class="mb-4">
    <button onclick="history.back()"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-gray-200 text-gray-700 hover:text-black hover:bg-gray-100 text-xs font-semibold shadow-xs transition-all cursor-pointer">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      <span>Back</span>
    </button>
  </div>

  <div class="bg-white rounded-3xl p-6 sm:p-10 border border-gray-200 shadow-md">
    <div class="mb-8 border-b border-gray-100 pb-4">
      <h2 class="text-2xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2">
        <i class="fa-regular fa-pen-to-square text-[#fe424d]"></i>
        Edit Your Listing
      </h2>
      <p class="text-gray-500 text-sm mt-1">Update details for your property listing.</p>
    </div>

    <form method="POST" action="/listings/<%= listing._id %>?_method=Put" novalidate
      class="needs-validation space-y-6" enctype="multipart/form-data">
      <div>
        <label for="title" class="block text-sm font-semibold text-gray-700 mb-1.5">Property Title</label>
        <input name="listing[title]" value="<%= listing.title %>" type="text"
          class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
          required />
        <div class="valid-feedback text-xs text-emerald-600 mt-1">Title looks good!</div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label for="description" class="block text-sm font-semibold text-gray-700">Description</label>
          <span id="descCount" class="text-xs text-gray-400 font-medium"><%= (listing.description || '').length %> / 500</span>
        </div>
        <textarea name="listing[description]" rows="4" maxlength="500"
          oninput="document.getElementById('descCount').textContent = `${this.value.length} / 500`"
          class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
          required><%= listing.description %></textarea>
        <div class="invalid-feedback text-xs text-rose-500 mt-1">Please enter short description</div>
      </div>

      <div class="mb-4">
        <label class="block text-xs font-semibold text-gray-500 mb-2">Original Listing Image Preview</label>
        <img id="imagePreview" src="<%= originalImageUrl ? originalImageUrl : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=400&q=60' %>"
          class="w-48 h-32 object-cover rounded-2xl border border-gray-200 shadow-sm" alt="Listing Image Preview" />
      </div>

      <div>
        <label for="image" class="block text-sm font-semibold text-gray-700 mb-1.5">Upload New Image (Optional)</label>
        <div class="relative border-2 border-dashed border-gray-300 hover:border-[#fe424d] bg-gray-50/50 rounded-2xl p-6 text-center transition-all">
          <input
            name="listing[image]"
            id="imageInput"
            type="file"
            accept="image/*"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
            onchange="if(this.files[0]) document.getElementById('fileName').textContent = this.files[0].name;"
          />
          <div class="space-y-2">
            <div class="w-10 h-10 rounded-full bg-red-50 text-[#fe424d] flex items-center justify-center mx-auto">
              <i data-lucide="upload-cloud" class="w-5 h-5"></i>
            </div>
            <p class="text-xs font-semibold text-gray-700">Click to upload new image</p>
            <p id="fileName" class="text-[11px] text-gray-400 truncate max-w-xs mx-auto">PNG, JPG, WEBP up to 10MB</p>
          </div>
        </div>
      </div>

      <div>
        <label for="category" class="block text-sm font-semibold text-gray-700 mb-1.5">Category</label>
        <% const categories = ["Trending", "Rooms", "Iconic Cities", "Castles", "Mountains", "Amazing Views", "Farms", "Beach", "Camping", "Arctic", "Domes", "Boats"]; %>
        <select
          name="listing[category]"
          class="form-select w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
          required
        >
          <% for(let cat of categories) { %>
            <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% } %>
        </select>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="price" class="block text-sm font-semibold text-gray-700 mb-1.5">Price (₹ / night)</label>
          <input name="listing[price]" value="<%= listing.price %>" type="number"
            class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
            required />
          <div class="invalid-feedback text-xs text-rose-500 mt-1">Price should be valid</div>
        </div>

        <div>
          <label for="country" class="block text-sm font-semibold text-gray-700 mb-1.5">Country</label>
          <input name="listing[country]" value="<%= listing.country %>" type="text"
            class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
            required />
          <div class="invalid-feedback text-xs text-rose-500 mt-1">Country should be valid</div>
        </div>
      </div>

      <div>
        <label for="location" class="block text-sm font-semibold text-gray-700 mb-1.5">Location / City</label>
        <input name="listing[location]" value="<%= listing.location %>" type="text"
          class="form-control w-full rounded-xl border-gray-300 focus:border-[#fe424d] focus:ring-[#fe424d] p-3 text-sm border shadow-sm transition-all"
          required />
        <div class="invalid-feedback text-xs text-rose-500 mt-1">Location should be valid</div>
      </div>

      <div class="pt-4 flex items-center gap-4">
        <button
          class="px-8 py-3 bg-[#fe424d] text-white font-bold rounded-xl hover:bg-[#e0323d] transition-all shadow-md hover:shadow-lg border-0 cursor-pointer text-base">
          Save Changes
        </button>
        <a href="/listings/<%= listing._id %>"
          class="px-6 py-3 bg-gray-100 text-gray-700 font-semibold rounded-xl hover:bg-gray-200 transition-all text-base decoration-none">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

<script>
  const imageInput = document.getElementById('imageInput');
  const imagePreview = document.getElementById('imagePreview');

  if (imageInput && imagePreview) {
    imageInput.addEventListener('change', function (e) {
      const [file] = e.target.files;
      if (file) {
        imagePreview.src = URL.createObjectURL(file);
      }
    });
  }
</script>