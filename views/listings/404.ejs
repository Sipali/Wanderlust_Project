<% layout("/layouts/boilerplate") %>

<div class="max-w-lg mx-auto py-12 text-center">
  <div class="bg-white rounded-3xl p-8 sm:p-10 border border-gray-200 shadow-xl space-y-6">
    
    <div class="relative w-24 h-24 bg-red-50 text-[#fe424d] rounded-3xl flex items-center justify-center mx-auto shadow-inner">
      <i data-lucide="compass" class="w-12 h-12 stroke-[2]"></i>
      <span class="absolute -top-2 -right-2 bg-[#fe424d] text-white font-extrabold text-xs px-2.5 py-1 rounded-full shadow-xs">404</span>
    </div>

    <div>
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">Page Not Found</h1>
      <p class="text-sm text-gray-500 max-w-sm mx-auto leading-relaxed">
        The page you requested doesn't exist, was removed, or the link may be broken.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <button onclick="history.back()" type="button" class="w-full sm:w-auto px-5 py-2.5 rounded-xl border border-gray-300 text-gray-700 font-semibold text-xs sm:text-sm hover:bg-gray-100 transition-all border-0 cursor-pointer flex items-center justify-center gap-1.5">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Go Back</span>
      </button>
      <a href="/listings" class="w-full sm:w-auto px-5 py-2.5 bg-[#fe424d] text-white font-bold rounded-xl hover:bg-[#e0323d] transition-all shadow-sm text-xs sm:text-sm flex items-center justify-center gap-1.5 decoration-none !text-white">
        <i data-lucide="home" class="w-4 h-4"></i>
        <span>Explore Listings</span>
      </a>
    </div>

  </div>
</div>
